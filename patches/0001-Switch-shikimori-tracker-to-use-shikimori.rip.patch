From 1775a18b9d8f6abbb922f2b62939ed8f0830f863 Mon Sep 17 00:00:00 2001
From: dm1sh <me@dmitriy.icu>
Date: Sun, 16 Aug 2026 19:07:46 +0300
Subject: [PATCH 1/2] Switch shikimori tracker to use shikimori.rip

Also point the Apollo GraphQL introspection endpoint at shikimori.rip,
since upstream moved the GraphQL API base out of ShikimoriApi.kt into
the Apollo Gradle configuration (AmanoTeam/Kahon ec614bb4c).
---
 app/build.gradle.kts                                        | 2 +-
 .../kanade/tachiyomi/data/track/shikimori/ShikimoriApi.kt   | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 80b5d5887..0e5feee27 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -320,7 +320,7 @@ apollo {
         srcDir(file(srcDir))
 
         introspection {
-            endpointUrl.set("https://shikimori.io/api/graphql")
+            endpointUrl.set("https://shikimori.rip/api/graphql")
             schemaFile.set(file("$srcDir/shikimori.graphqls"))
         }
 
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/shikimori/ShikimoriApi.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/shikimori/ShikimoriApi.kt
index bc02fa039..13aa54bea 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/data/track/shikimori/ShikimoriApi.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/track/shikimori/ShikimoriApi.kt
@@ -213,15 +213,15 @@ class ShikimoriApi(
     )
 
     companion object {
-        private const val BASE_URL = "https://shikimori.io"
+        private const val BASE_URL = "https://shikimori.rip"
         private const val API_URL = "$BASE_URL/api"
         private const val OAUTH_URL = "$BASE_URL/oauth/token"
         private const val LOGIN_URL = "$BASE_URL/oauth/authorize"
 
         private const val REDIRECT_URL = "mihon://shikimori-auth"
 
-        private const val CLIENT_ID = "PB9dq8DzI405s7wdtwTdirYqHiyVMh--djnP7lBUqSA"
-        private const val CLIENT_SECRET = "NajpZcOBKB9sJtgNcejf8OB9jBN1OYYoo-k4h2WWZus"
+        private const val CLIENT_ID = "2rJVVS8VKw8LdkhSF0a4kOFcW-iwS7PPcDVIpp6049w"
+        private const val CLIENT_SECRET = "wQhZFcH40JG_pTzAZE1R13Er593B2ndHA1gtKZgxblc"
 
         fun authUrl(): Uri = LOGIN_URL.toUri().buildUpon()
             .appendQueryParameter("client_id", CLIENT_ID)
