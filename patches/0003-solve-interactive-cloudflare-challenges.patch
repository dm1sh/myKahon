+++ b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareInterceptor.kt
@@ -273,6 +273,12 @@ class CloudflareInterceptor(
         if (!cloudflareBypassed) {
             // A clearance from a failed challenge would only be rejected again
             cookieManager.remove(originalRequest.url, COOKIE_NAMES, 0)
+            // Fall back to a user-visible WebView: the headless one cannot complete interactive
+            // challenges, so hand them to the person in front of the screen instead of failing
+            if (CloudflareChallengeActivity.solve(context, origRequestUrl, headers, ignoreSslErrors)) {
+                return
+            }
+
             // Prompt user to update WebView if it seems too outdated
             if (isWebViewOutdated) {
                 context.toast(MR.strings.information_webview_outdated, Toast.LENGTH_LONG)
