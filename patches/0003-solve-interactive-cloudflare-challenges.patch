 .../CloudflareChallengeActivity.kt            | 173 ++++++++++++++++++
 .../interceptor/CloudflareInterceptor.kt      |  16 ++
 3 files changed, 200 insertions(+), 1 deletion(-)
 create mode 100644 core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareChallengeActivity.kt

