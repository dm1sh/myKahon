--- a/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/AndroidCookieJar.kt
+++ b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/AndroidCookieJar.kt
@@ -42,7 +42,8 @@ class AndroidCookieJar : CookieJar {
         }
 
         return cookies.split(";")
-            .map { it.substringBefore("=") }
+            // getCookie joins cookies with "; " with a leading space on all but the first one
+            .map { it.trim().substringBefore("=") }
             .filterNames()
             .onEach { manager.setCookie(urlString, "$it=;Max-Age=$maxAge") }
             .count()
diff --git a/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareChallengeActivity.kt b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareChallengeActivity.kt
new file mode 100644
index 0000000..4668797
--- /dev/null
+++ b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareChallengeActivity.kt
@@ -0,0 +1,210 @@
+package eu.kanade.tachiyomi.network.interceptor
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.graphics.Color
+import android.net.http.SslError
+import android.os.Bundle
+import android.view.Gravity
+import android.view.ViewGroup
+import android.webkit.RenderProcessGoneDetail
+import android.webkit.SslErrorHandler
+import android.webkit.WebResourceError
+import android.webkit.WebResourceRequest
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.core.content.ContextCompat
+import eu.kanade.tachiyomi.network.AndroidCookieJar
+import eu.kanade.tachiyomi.util.system.WebViewUtil
+import eu.kanade.tachiyomi.util.system.setDefaultSettings
+import eu.kanade.tachiyomi.util.system.setUserAgent
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import tachiyomi.core.common.util.system.logcat
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * A user-facing screen for solving a Cloudflare challenge the headless WebView in
+ * [CloudflareInterceptor] cannot pass on its own, like interactive Turnstile ones.
+ *
+ * The WebView is loaded with the triggering request's headers (most importantly its
+ * User-Agent), and its cookies land in the shared [AndroidCookieJar] storage, so the
+ * clearance earned here applies to the request that caused the challenge.
+ */
+class CloudflareChallengeActivity : Activity() {
+
+    private val id: Long by lazy { intent.getLongExtra(EXTRA_ID, -1L) }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        val challengeUrl = intent.getStringExtra(EXTRA_URL)!!
+        val parsedUrl = challengeUrl.toHttpUrlOrNull()!!
+        val headers = intent.getSerializableExtra(EXTRA_HEADERS) as? HashMap<String, String> ?: hashMapOf()
+        val ignoreSslErrors = intent.getBooleanExtra(EXTRA_IGNORE_SSL_ERRORS, false)
+
+        val cookieJar = AndroidCookieJar()
+        val originalClearance = cookieJar.get(parsedUrl).firstOrNull { it.name == CLEARANCE_COOKIE_NAME }?.value
+
+        val padding = (resources.displayMetrics.density * 16).toInt()
+
+        val title = TextView(this).apply {
+            gravity = Gravity.CENTER
+            setPadding(padding, padding / 2, padding, 0)
+            setTextColor(Color.BLACK)
+            textSize = 16f
+            text = parsedUrl.host
+        }
+
+        val webView = WebView(this).apply {
+            setDefaultSettings()
+
+            if (!WebViewUtil.isFingerprintSpooferActive(this@CloudflareChallengeActivity)) {
+                // Avoid sending empty User-Agent, Chromium WebView will reset to default if empty
+                setUserAgent(headers["User-Agent"].takeUnless { it.isNullOrBlank() } ?: "Kahon")
+            }
+
+            webViewClient = object : WebViewClient() {
+                override fun onReceivedSslError(view: WebView, handler: SslErrorHandler, error: SslError) {
+                    if (ignoreSslErrors) {
+                        handler.proceed()
+                    } else {
+                        super.onReceivedSslError(view, handler, error)
+                    }
+                }
+
+                override fun onReceivedError(view: WebView, request: WebResourceRequest, error: WebResourceError) {
+                    // Subresource failures are expected, but a main frame that can't be loaded would only
+                    // leave the screen stuck until the solve timeout.
+                    if (request.isForMainFrame) {
+                        logcat { "Visible Cloudflare bypass for $parsedUrl failed to load: ${error.description}" }
+                        release(id, false)
+                        finish()
+                    }
+                }
+
+                override fun onRenderProcessGone(view: WebView, detail: RenderProcessGoneDetail): Boolean {
+                    logcat { "WebView renderer gone during visible Cloudflare bypass: crashed=${detail.didCrash()}" }
+                    release(id, false)
+                    // Not handling it kills the app
+                    return true
+                }
+
+                override fun onPageFinished(view: WebView, url: String) {
+                    // The clearance might be granted on the loaded page itself or after a redirect
+                    val clearance = cookieJar.get(parsedUrl).firstOrNull { it.name == CLEARANCE_COOKIE_NAME }?.value
+                    if (!clearance.isNullOrBlank() && clearance != originalClearance) {
+                        release(id, true)
+                        finish()
+                    }
+                }
+            }
+        }
+
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setBackgroundColor(Color.WHITE)
+        }
+        root.addView(
+            title,
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
+        )
+        root.addView(
+            webView,
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0).apply { weight = 1f },
+        )
+        setContentView(
+            root,
+            ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT),
+        )
+
+        webView.loadUrl(challengeUrl, headers)
+    }
+
+    override fun onDestroy() {
+        release(id, false)
+        super.onDestroy()
+    }
+
+    private class Waiter {
+        val latch = CountDownLatch(1)
+        val released = AtomicBoolean(false)
+
+        @Volatile
+        var solved = false
+    }
+
+    companion object {
+        private const val EXTRA_URL = "url"
+        private const val EXTRA_HEADERS = "headers"
+        private const val EXTRA_IGNORE_SSL_ERRORS = "ignoreSslErrors"
+        private const val EXTRA_ID = "id"
+        private const val CLEARANCE_COOKIE_NAME = "cf_clearance"
+        private const val SOLVE_TIMEOUT_MINUTES = 3L
+
+        private val nextId = AtomicLong()
+        private val waiters = ConcurrentHashMap<Long, Waiter>()
+
+        /**
+         * Opens the challenge screen for the person in front of the device, and blocks the
+         * caller until it is solved, dismissed or a timeout is reached. Returns whether the
+         * clearance cookie was acquired.
+         *
+         * The caller is an OkHttp thread, but the screen's callbacks run on the main thread, so
+         * no lock may be held while waiting here: [release] must never block the UI thread.
+         */
+        fun solve(context: Context, url: String, headers: Map<String, String>, ignoreSslErrors: Boolean): Boolean {
+            val parsedUrl = url.toHttpUrlOrNull() ?: return false
+
+            val id = nextId.incrementAndGet()
+            val waiter = Waiter()
+            waiters[id] = waiter
+
+            // A clearance from a failed challenge would only be rejected again
+            AndroidCookieJar().remove(parsedUrl, listOf(CLEARANCE_COOKIE_NAME), 0)
+
+            val intent = Intent(context, CloudflareChallengeActivity::class.java).apply {
+                putExtra(EXTRA_URL, url)
+                putExtra(EXTRA_HEADERS, HashMap(headers))
+                putExtra(EXTRA_IGNORE_SSL_ERRORS, ignoreSslErrors)
+                putExtra(EXTRA_ID, id)
+                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            }
+            ContextCompat.getMainExecutor(context).execute {
+                try {
+                    context.startActivity(intent)
+                } catch (e: Exception) {
+                    logcat { "Failed to open the visible Cloudflare bypass for $url" }
+                    release(id, false)
+                }
+            }
+
+            val timedOut = try {
+                !waiter.latch.await(SOLVE_TIMEOUT_MINUTES, TimeUnit.MINUTES)
+            } catch (e: InterruptedException) {
+                Thread.currentThread().interrupt()
+                true
+            } finally {
+                waiters.remove(id)
+            }
+
+            logcat {
+                "Visible Cloudflare bypass for $url finished: solved=${waiter.solved} timedOut=$timedOut"
+            }
+            return waiter.solved
+        }
+
+        private fun release(id: Long, isSolved: Boolean) {
+            val waiter = waiters[id] ?: return
+            if (!waiter.released.compareAndSet(false, true)) return
+            if (isSolved) waiter.solved = true
+            waiter.latch.countDown()
+        }
+    }
+}
diff --git a/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareInterceptor.kt b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareInterceptor.kt
index be44e6e..d65d0a1 100644
--- a/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareInterceptor.kt
+++ b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/CloudflareInterceptor.kt
@@ -113,6 +113,22 @@ class CloudflareInterceptor(
         // Because OkHttp's enqueue only handles IOExceptions, wrap the exception so that
         // we don't crash the entire app
         catch (e: CloudflareBypassException) {
+            // The headless WebView can't pass challenges that require interaction, so hand them
+            // to the person in front of the device instead of failing the request. The clearance
+            // earned there lands in the shared cookie jar and is reused by this request.
+            val challengeUrl = if (request.method == "GET") {
+                request.url.toString()
+            } else {
+                request.url.newBuilder().encodedPath("/").query(null).fragment(null).build().toString()
+            }
+            val solved = CloudflareChallengeActivity.solve(
+                context,
+                challengeUrl,
+                request.headers.toWebViewHeaders(),
+                fingerprintSpooferActive,
+            )
+            if (solved) return
+
             throw IOException(context.stringResource(MR.strings.information_cloudflare_bypass_failure), e)
         } catch (e: Exception) {
             throw IOException(e)
-- 
