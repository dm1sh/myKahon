From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dm1sh <me@dmitriy.icu>
Date: Thu, 3 Sep 2026 12:00:00 +0100
Subject: [PATCH] Build: minSdk 25, per-ABI APK splits, universal APK

Lower minSdk to 25 and produce per-ABI APKs for armeabi-v7a,
arm64-v8a, x86 and x86_64 plus a universal APK.

For API 25 compatibility:
- Move the four shortcut icons to drawable-v26 (adaptive-icon requires
  API 26) and provide plain vector fallbacks in drawable/ for API 25.
- Add a mipmap-anydpi/ic_launcher fallback for API < 26 (the launcher
  icon was previously adaptive-only in mipmap-anydpi-v26, which broke
  the splash screen resource lookup at runtime).
- Guard canRequestPackageInstalls() (API 26+) in the install permission
  state observer to avoid a NoSuchMethodError on API < 26.
---
diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 0ec2a3f..d8776e8 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -18,7 +18,7 @@ plugins {
     alias(libs.plugins.kotlin.serialization)
 }
 
-val supportedAbis = setOf("armeabi-v7a", "arm64-v8a")
+val supportedAbis = setOf("armeabi-v7a", "arm64-v8a", "x86", "x86_64")
 
 val keystorePropertiesFile = rootProject.file("keystore.properties")
 
@@ -90,6 +90,15 @@ android {
         }
     }
 
+    splits {
+        abi {
+            isEnable = true
+            reset()
+            include(*supportedAbis.toTypedArray())
+            isUniversalApk = true
+        }
+    }
+
     dependenciesInfo {
         includeInApk = Config.includeDependencyInfo
         includeInBundle = Config.includeDependencyInfo
diff --git a/app/src/main/java/eu/kanade/presentation/util/Permissions.kt b/app/src/main/java/eu/kanade/presentation/util/Permissions.kt
index 80c2f90..924e7bc 100644
--- a/app/src/main/java/eu/kanade/presentation/util/Permissions.kt
+++ b/app/src/main/java/eu/kanade/presentation/util/Permissions.kt
@@ -1,5 +1,6 @@
 package eu.kanade.presentation.util
 
+import android.os.Build
 import androidx.compose.runtime.Composable
 import androidx.compose.runtime.DisposableEffect
 import androidx.compose.runtime.getValue
@@ -21,7 +22,11 @@ fun rememberRequestPackageInstallsPermissionState(initialValue: Boolean = false)
     DisposableEffect(lifecycleOwner.lifecycle) {
         val observer = object : DefaultLifecycleObserver {
             override fun onResume(owner: LifecycleOwner) {
-                installGranted = context.packageManager.canRequestPackageInstalls()
+                installGranted = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                    context.packageManager.canRequestPackageInstalls()
+                } else {
+                    true
+                }
             }
         }
         lifecycleOwner.lifecycle.addObserver(observer)
